# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). Na Vercel, cadastre as mesmas duas variáveis
# em Settings → Environment Variables.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Publishable key (sb_publishable_...) ou a antiga "anon public". NUNCA use a secret / service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_cole_a_sua_aqui
